erro quando ligado com apenas um gateway e uma coleira, é preciso montar uma estratégia para que o relay não atrapalhe a chegada de uma comunicação da coleira em qualquer gateway.#1.2. gateway descarta (nao acontece todas as vezes, mas em algumas transmissões da coleira acontece)#{1}":[101,106],"#ruraltech#2. Validar queue/downlink cloud = provar que a matriz também funciona no sentido nuvem → matriz, não só escrevendo telemetria para a nuvem.":[107,108],"#ruraltech#3. Subir para stage 5 com SD = adicionar a camada de persistência local em SD ao cenário já validado de cloud/backhaul.":[109,109]},"outlinks":[],"metadata":{"tags":["#ruraltech"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[7,97],[101,105]],"key":"inbox.md"},"smart_blocks:inbox.md#ruraltech": {"path":null,"last_embed":{"hash":"j8qlwf","at":1776632775083},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06565508,-0.00534991,0.04695556,-0.01705436,0.02103313,-0.05621993,-0.05881597,0.0246068,0.0353807,-0.02483878,-0.01249042,-0.14206791,0.01645863,-0.01144572,0.04183674,0.04790543,0.00517457,-0.00951298,0.01008055,0.01361769,0.11725693,-0.03041776,0.01548581,-0.03690413,0.0353873,0.0143092,0.0038159,0.02384556,-0.07180833,-0.1841087,0.05393166,0.00537633,0.00602791,0.04881975,-0.04448039,-0.02550431,-0.02482157,-0.04628192,-0.01926324,0.0211126,0.02745619,0.00033662,0.00711264,-0.01849738,-0.01621633,-0.04792332,-0.01465239,-0.03767259,0.04838109,-0.01964381,0.00868407,0.04034955,0.00473217,-0.00999668,0.04267858,0.07251512,0.09666122,0.06948349,0.06758565,-0.0275457,0.07408315,0.07441693,-0.20278823,0.03180731,0.05757474,0.03214668,-0.05555156,-0.00561776,0.04533058,0.02620519,-0.04314141,-0.00965416,0.04275779,0.02149549,0.02329138,0.0447926,-0.05672941,-0.00640947,0.00111969,-0.00401816,-0.01336676,0.04926761,-0.0327972,0.01547688,-0.02401993,0.0110203,0.01051241,0.02724645,0.02966349,0.01872919,-0.07338424,0.03852334,0.01754402,0.04100001,-0.0444583,-0.04235574,-0.00344336,0.01187359,-0.05147921,0