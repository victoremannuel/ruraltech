rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(uid());
    }

    function userDoc() {
      return get(userRef());
    }

    function isAdmin() {
      return signedIn() &&
        exists(userRef()) &&
        userDoc().data.role == 'adm';
    }

    function isPropertyOwner(propertyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/ruralProperties/$(propertyId)) &&
        get(/databases/$(database)/documents/ruralProperties/$(propertyId)).data.createdByUid == userRef();
    }

    function hasUserAccess(resourceData) {
      return signedIn() &&
        ('userUids' in resourceData) &&
        (userRef() in resourceData.userUids);
    }

    function canAccessCollar(collarId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/collars/$(collarId)) &&
        get(/databases/$(database)/documents/collars/$(collarId)).data.ownerUid == userRef()
      );
    }

    function canAccessProperty(propertyId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/ruralProperties/$(propertyId)) &&
        (
          isPropertyOwner(propertyId) ||
          hasUserAccess(get(/databases/$(database)/documents/ruralProperties/$(propertyId)).data)
        )
      );
    }

    function canAccessGateway(gatewayData) {
      return isAdmin() || (
        ('propertyId' in gatewayData) &&
        (gatewayData.propertyId != null) &&
        canAccessProperty(gatewayData.propertyId.id)
      );
    }

    function canAccessArea(areaData) {
      return isAdmin() || (
        ('ruralPropertiesID' in areaData) &&
        (areaData.ruralPropertiesID != null) &&
        canAccessProperty(areaData.ruralPropertiesID.id)
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() &&
        uid() == userId &&
        request.resource.data.role == 'user';
      allow update: if signedIn() && (
        (uid() == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /collars/{collarId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.ownerUid == userRef()
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || resource.data.ownerUid == userRef();
    }

    match /gateways/{gatewayId} {
      allow read: if signedIn() && canAccessGateway(resource.data);
      allow create, delete: if isAdmin();
      allow update: if signedIn() && (
        isAdmin() ||
        canAccessGateway(resource.data)
      );
    }

    match /ruralProperties/{propertyId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.createdByUid == userRef() ||
        hasUserAccess(resource.data)
      );
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.createdByUid == userRef() &&
            ('userUids' in request.resource.data) &&
            userRef() in request.resource.data.userUids
          )
        );
      allow update, delete: if isAdmin() || resource.data.createdByUid == userRef();
    }

    match /areas/{areaId} {
      allow read: if signedIn() && canAccessArea(resource.data);
      allow create: if signedIn() && (
        isAdmin() ||
        (
          'ruralPropertiesID' in request.resource.data &&
          request.resource.data.ruralPropertiesID != null &&
          canAccessProperty(request.resource.data.ruralPropertiesID.id)
        )
      );
      allow update, delete: if signedIn() && (
        isAdmin() ||
        canAccessArea(resource.data)
      );
    }

    match /fences/{docId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (resource.data.ownerUid == userRef())
      );
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == userRef() &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow delete: if isAdmin();
    }

    match /herdingPlans/{docId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (resource.data.ownerUid == userRef())
      );
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == userRef() &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (resource.data.ownerUid == userRef())
      );
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == userRef() &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow update, delete: if isAdmin();
    }
  }
}
