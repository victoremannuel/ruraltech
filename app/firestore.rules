rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(uid());
    }

    function userDoc() {
      return get(userRef());
    }

    function isAdmin() {
      return signedIn() &&
        exists(userRef()) &&
        userDoc().data.role == 'adm';
    }

    function hasUserAccess(resourceData) {
      return signedIn() &&
        ('userUids' in resourceData) &&
        (userRef() in resourceData.userUids);
    }

    function canAccessCollar(collarId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/collars/$(collarId)) &&
        hasUserAccess(get(/databases/$(database)/documents/collars/$(collarId)).data)
      );
    }

    function canAccessProperty(propertyId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/ruralProperties/$(propertyId)) &&
        hasUserAccess(get(/databases/$(database)/documents/ruralProperties/$(propertyId)).data)
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() &&
        uid() == userId &&
        request.resource.data.role == 'user';
      allow update: if signedIn() && (
        (uid() == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /collars/{collarId} {
      allow read: if signedIn() && (isAdmin() || hasUserAccess(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /gateways/{gatewayId} {
      allow read: if signedIn() && (isAdmin() || hasUserAccess(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /ruralProperties/{propertyId} {
      allow read: if signedIn() && (isAdmin() || hasUserAccess(resource.data));
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.createdByUid == userRef() &&
            ('userUids' in request.resource.data) &&
            request.resource.data.userUids.size() == 1 &&
            userRef() in request.resource.data.userUids
          )
        );
      allow update, delete: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (
          'ruralPropertiesID' in resource.data &&
          canAccessProperty(resource.data.ruralPropertiesID.id)
        )
      );
      allow create: if signedIn() && (
        isAdmin() ||
        (
          request.resource.data.ownerUid == userRef() &&
          'ruralPropertiesID' in request.resource.data &&
          canAccessProperty(request.resource.data.ruralPropertiesID.id)
        )
      );
      allow update, delete: if isAdmin();
    }

    match /fences/{docId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (resource.data.ownerUid == userRef())
      );
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == userRef() &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow delete: if isAdmin();
    }

    match /herdingPlans/{docId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (resource.data.ownerUid == userRef())
      );
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == userRef() &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (resource.data.ownerUid == userRef())
      );
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == userRef() &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow update, delete: if isAdmin();
    }
  }
}
