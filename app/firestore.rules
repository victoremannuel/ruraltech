rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(uid());
    }

    function userPath() {
      return '/users/' + uid();
    }

    function matchesCurrentUserRef(value) {
      return value == userRef() || value == userPath() || value == uid();
    }

    function userDoc() {
      return get(userRef());
    }

    function isAdmin() {
      return signedIn() &&
        exists(userRef()) &&
        userDoc().data.role == 'adm';
    }

    function isPropertyOwner(propertyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/ruralProperties/$(propertyId)) &&
        matchesCurrentUserRef(
          get(/databases/$(database)/documents/ruralProperties/$(propertyId)).data.createdByUid
        );
    }

    function hasUserAccess(resourceData) {
      return signedIn() &&
        ('userUids' in resourceData) &&
        (
          userRef() in resourceData.userUids ||
          userPath() in resourceData.userUids ||
          uid() in resourceData.userUids
        );
    }

    function listContainsCurrentUser(listValue) {
      return signedIn() &&
        listValue is list &&
        (
          userRef() in listValue ||
          userPath() in listValue ||
          uid() in listValue
        );
    }

    function canAccessCollar(collarId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/collars/$(collarId)) &&
        matchesCurrentUserRef(
          get(/databases/$(database)/documents/collars/$(collarId)).data.ownerUid
        )
      );
    }

    function canAccessProperty(propertyId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/ruralProperties/$(propertyId)) &&
        (
          isPropertyOwner(propertyId) ||
          hasUserAccess(get(/databases/$(database)/documents/ruralProperties/$(propertyId)).data)
        )
      );
    }

    function canAccessPropertyByPath(propertyPath) {
      return signedIn() &&
        propertyPath is string &&
        propertyPath.matches('^/ruralProperties/[^/]+$') &&
        canAccessProperty(propertyPath.split('/')[2]);
    }

    function canAccessPropertyField(propertyField) {
      return signedIn() &&
        propertyField != null &&
        propertyField is string &&
        (
          canAccessPropertyByPath(propertyField) ||
          (
            !propertyField.matches('^/.+$') &&
            canAccessProperty(propertyField)
          )
        );
    }

    function canAccessGateway(gatewayData) {
      return isAdmin() || (
        ('propertyId' in gatewayData) &&
        canAccessPropertyField(gatewayData.propertyId)
      );
    }

    function canAccessArea(areaData) {
      return isAdmin() || (
        ('ruralPropertiesID' in areaData) &&
        canAccessPropertyField(areaData.ruralPropertiesID)
      );
    }

    function canAccessHerdingOperation(operationData) {
      return isAdmin() ||
        matchesCurrentUserRef(operationData.ownerUid) ||
        matchesCurrentUserRef(operationData.requestedByUid) ||
        listContainsCurrentUser(operationData.notifyUserIds) ||
        (
          ('propertyId' in operationData) &&
          canAccessPropertyField(operationData.propertyId)
        );
    }

    match /users/{userId} {
      // Required by profile filters to resolve owner emails for related entities.
      allow read: if signedIn();
      allow create: if signedIn() &&
        uid() == userId &&
        request.resource.data.role == 'user';
      allow update: if signedIn() && (
        (uid() == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /collars/{collarId} {
      allow read: if signedIn() && (
        isAdmin() ||
        matchesCurrentUserRef(resource.data.ownerUid)
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || matchesCurrentUserRef(resource.data.ownerUid);
    }

    match /gateways/{gatewayId} {
      allow read: if signedIn() && (
        isAdmin() ||
        hasUserAccess(resource.data) ||
        canAccessGateway(resource.data)
      );
      allow create, delete: if isAdmin();
      allow update: if signedIn() && (
        isAdmin() ||
        hasUserAccess(resource.data) ||
        canAccessGateway(resource.data)
      );
    }

    match /ruralProperties/{propertyId} {
      allow read: if signedIn() && (
        isAdmin() ||
        matchesCurrentUserRef(resource.data.createdByUid) ||
        hasUserAccess(resource.data)
      );
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            matchesCurrentUserRef(request.resource.data.createdByUid) &&
            ('userUids' in request.resource.data) &&
            (
              userRef() in request.resource.data.userUids ||
              userPath() in request.resource.data.userUids ||
              uid() in request.resource.data.userUids
            )
          )
        );
      allow update, delete: if isAdmin() || matchesCurrentUserRef(resource.data.createdByUid);
    }

    match /areas/{areaId} {
      allow read: if signedIn() && (
        isAdmin() ||
        hasUserAccess(resource.data) ||
        matchesCurrentUserRef(resource.data.ownerUid) ||
        canAccessArea(resource.data)
      );
      allow create: if signedIn() && (
        isAdmin() ||
        (
          hasUserAccess(request.resource.data) ||
          matchesCurrentUserRef(request.resource.data.ownerUid) ||
          canAccessArea(request.resource.data)
        )
      );
      allow update, delete: if signedIn() && (
        isAdmin() ||
        hasUserAccess(resource.data) ||
        matchesCurrentUserRef(resource.data.ownerUid) ||
        canAccessArea(resource.data)
      );
    }

    match /fences/{docId} {
      allow read: if signedIn() && (
        isAdmin() ||
        matchesCurrentUserRef(resource.data.ownerUid)
      );
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            matchesCurrentUserRef(request.resource.data.ownerUid) &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow delete: if isAdmin();
    }

    match /herdingPlans/{docId} {
      allow read: if signedIn() && (
        isAdmin() ||
        matchesCurrentUserRef(resource.data.ownerUid)
      );
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            matchesCurrentUserRef(request.resource.data.ownerUid) &&
            canAccessCollar(request.resource.data.deviceId)
          )
      );
      allow delete: if isAdmin();
    }

    match /herdingOperations/{operationId} {
      allow read: if signedIn() && canAccessHerdingOperation(resource.data);
      allow create: if signedIn() && (
        isAdmin() ||
        (
          matchesCurrentUserRef(request.resource.data.requestedByUid) &&
          canAccessPropertyField(request.resource.data.propertyId) &&
          listContainsCurrentUser(request.resource.data.notifyUserIds)
        )
      );
      allow update: if signedIn() && (
        isAdmin() ||
        matchesCurrentUserRef(resource.data.requestedByUid) ||
        matchesCurrentUserRef(resource.data.ownerUid)
      );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn() && (
        isAdmin() ||
        matchesCurrentUserRef(resource.data.ownerUid)
      );
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            matchesCurrentUserRef(request.resource.data.ownerUid) &&
            canAccessCollar(request.resource.data.deviceId)
          )
        );
      allow update, delete: if isAdmin();
    }
  }
}
