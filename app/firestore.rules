rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(uid())) &&
        userDoc().data.role == 'adm';
    }

    function isOwner(resourceData) {
      return signedIn() && resourceData.ownerUid == uid();
    }

    function hasUserAccess(resourceData) {
      return signedIn() &&
        ('userUids' in resourceData) &&
        (uid() in resourceData.userUids);
    }

    function canAccessDevice(deviceId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/devices/$(deviceId)) &&
        hasUserAccess(get(/databases/$(database)/documents/devices/$(deviceId)).data)
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() &&
        uid() == userId &&
        request.resource.data.role == 'user';
      allow update: if signedIn() && (
        (uid() == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if signedIn() && (isAdmin() || hasUserAccess(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /gateways/{gatewayId} {
      allow read: if signedIn() && (isAdmin() || hasUserAccess(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /ruralProperties/{propertyId} {
      allow read: if signedIn() && (isAdmin() || hasUserAccess(resource.data));
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.createdByUid == uid() &&
            ('userUids' in request.resource.data) &&
            request.resource.data.userUids.size() == 1 &&
            uid() in request.resource.data.userUids
          )
        );
      allow update, delete: if isAdmin();
    }

    match /fences/{docId} {
      allow read: if signedIn() && (isAdmin() || isOwner(resource.data));
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == uid() &&
            canAccessDevice(request.resource.data.deviceId)
          )
        );
      allow delete: if isAdmin();
    }

    match /herdingPlans/{docId} {
      allow read: if signedIn() && (isAdmin() || isOwner(resource.data));
      allow create, update: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == uid() &&
            canAccessDevice(request.resource.data.deviceId)
          )
        );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn() && (isAdmin() || isOwner(resource.data));
      allow create: if signedIn() &&
        (
          isAdmin() ||
          (
            request.resource.data.ownerUid == uid() &&
            canAccessDevice(request.resource.data.deviceId)
          )
        );
      allow update, delete: if isAdmin();
    }
  }
}
